# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Europe/Madrid

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clave para cifrar tokens de Outlook y la API key de Holded (mín. 32 caracteres): openssl rand -base64 48
ENCRYPTION_KEY=

# Secreto para los crons (Vercel lo envía como Bearer automáticamente): openssl rand -hex 32
CRON_SECRET=

# --- Microsoft 365 / Outlook (Azure → App registrations) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" para cuentas de cualquier organización, o el Tenant ID de tu empresa
MS_TENANT_ID=common

# --- Asistente IA (Claude) ---
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=

# --- Notificaciones push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
